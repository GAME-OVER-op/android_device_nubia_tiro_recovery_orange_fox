# Reproducible OrangeFox source profile.
# The known-good reference ramdisk is Android 14 / SDK 34 and the original
# device tree explicitly targets OrangeFox fox_14.1.
FOX_SYNC_REV=14eca5f7
FOX_BRANCH=14.1
TARGET_DEVICE=tiro
TARGET_MODEL=NX769J
RECOVERY_PARTITION_SIZE=104857600
BOOT_HEADER_VERSION=4
RAMDISK_COMPRESSION=lz4
