# Build source lock for the first tiro source-build validation.
# The OrangeFox sync helper commit is deliberately pinned. The helper itself
# selects fox_12.1 recovery/vendor branches and the TWRP 12.1 minimal manifest.
FOX_SYNC_REV=14eca5f7
FOX_BRANCH=12.1
TARGET_DEVICE=tiro
TARGET_MODEL=NX769J
RECOVERY_PARTITION_SIZE=104857600
BOOT_HEADER_VERSION=4
RAMDISK_COMPRESSION=lz4
